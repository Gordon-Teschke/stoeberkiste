<nav class="sk-account-links" aria-label="Benutzerfunktionen">
    {% if oxcmp_user and oxcmp_user.oxuser__oxpassword.value %}
        <a href="{{ seo_url({ ident: oViewConf.getSslSelfLink() ~ "cl=account" }) }}">{{ translate({ ident: "MY_ACCOUNT" }) }}</a>
        <a href="{{ oViewConf.getLogoutLink()|raw }}">{{ translate({ ident: "LOGOUT" }) }}</a>
    {% else %}
        <a href="{{ seo_url({ ident: oViewConf.getSslSelfLink() ~ "cl=register" }) }}">{{ translate({ ident: "REGISTER" }) }}</a>
        <a href="{{ seo_url({ ident: oViewConf.getSslSelfLink() ~ "cl=account" }) }}">{{ translate({ ident: "LOGIN" }) }}</a>
    {% endif %}
    <a href="{{ seo_url({ ident: oViewConf.getSelfLink() ~ "cl=account_noticelist" }) }}">
        Merkliste{% if oxcmp_user and oxcmp_user.getNoticeListArtCnt() %} <span class="badge js-noticeListCnt">{{ oxcmp_user.getNoticeListArtCnt() }}</span>{% endif %}
    </a>
</nav>
