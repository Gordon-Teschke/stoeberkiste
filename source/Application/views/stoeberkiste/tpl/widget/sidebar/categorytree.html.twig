{% block dd_widget_sidebar_categorytree %}
    {% if oxcmp_categories %}
        {# Always start with the complete root collection. getClickRoot() only
           returns the active branch and hid the other top-level categories. #}
        {% set categories = oxcmp_categories %}
        {% set act = oxcmp_categories.getClickCat() %}
        {% if categories %}
            {% set deepLevel = oView.getDeepLevel() %}
            <nav class="categoryBox d-block d-sm-none d-md-block" aria-labelledby="sidebar-header">
                <div class="sidebar-header"><strong>Nach Kategorien</strong></div>
                {% block dd_widget_sidebar_categorytree_inner %}
                    <ol class="nav flex-column">
                        {% block dd_widget_sidebar_categorytree_list %}
                            {% macro tree(categories) %}
                                {% set deepLevel = deepLevel+1 %}
                                {% set oContentCat = oView.getContentCategory() %}
                                {% for _cat in categories %}
                                    {% set catTitle = _cat.oxcategories__oxtitle.value|trim %}
                                    {% if _cat.getIsVisible() and catTitle %}
                                        {# CMS category #}
                                        {% if _cat.getContentCats() and deepLevel > 1 %}
                                            {% for _oCont in _cat.getContentCats() %}
                                                {% set contentTitle = _oCont.oxcontents__oxtitle.value|trim %}
                                                {% if contentTitle %}
                                                    <li class="nav-item{% if oContentCat and oContentCat.getId()==_oCont.getId() %} active{% else %} end{% endif %}" >
                                                        <a class="nav-link" href="{{ _oCont.getLink()|raw }}" title="{{ contentTitle }}"><i></i>{{ contentTitle }}</a>
                                                    </li>
                                                {% endif %}
                                            {% endfor %}
                                        {% endif %}

                                        {# subcategories #}
                                        {% set oSubCats = _cat.getSubCats() %}
                                        {% set hasVisibleSubCats = _cat.getHasVisibleSubCats() %}
                                        <li class="nav-item{% if not oContentCat and act and act.getId()==_cat.getId() %} active{% elseif _cat.expanded %} exp{% endif %}{% if not hasVisibleSubCats %} end{% endif %}">
                                            <a class="nav-link" href="{{ _cat.getLink()|raw }}" title="{{ catTitle }}">
                                                <svg>
                                                    <use xlink:href="#{% if _cat.expanded and hasVisibleSubCats %}down{% else %}right{% endif %}"></use>
                                                </svg>
                                                {{ catTitle }}
                                                {% if oView.showCategoryArticlesCount() and (_cat.getNrOfArticles() > 0) %}
                                                    <span class="text-muted">({{ _cat.getNrOfArticles() }})</span>
                                                {% endif %}
                                            </a>
                                            {% if hasVisibleSubCats and _cat.expanded %}
                                                <ul class="nav flex-column">{% import _self as self %}{{ self.tree(oSubCats) }}</ul>
                                            {% endif %}
                                        </li>
                                    {% endif %}
                                {% endfor %}
                            {% endmacro %}{% import _self as self %}{{ self.tree(categories) }}
                        {% endblock %}
                    </ol>
                {% endblock %}
            </nav>
        {% endif %}
    {% endif %}
{% endblock %}
