{#
  Shared shop navigation used by category, CMS, product and account pages.
  The markup deliberately follows the legacy Smarty theme because style.css
  already contains the pixel-near desktop/mobile rules for these classes.
#}
<aside class="side-menu-complete sk-side-menu" aria-label="Shopnavigation">
    <div class="shop-menu">
        {{ include_widget({
            cl: "oxwCategoryTree",
            cnid: oView.getCategoryId(),
            deepLevel: 0,
            noscript: 1,
            nocookie: 1
        }) }}
    </div>

    {# The legacy storefront uses the same curated manufacturer navigation on
