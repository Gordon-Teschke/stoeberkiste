{#
  Shared shop navigation used by category, CMS, product and account pages.
  The markup deliberately follows the legacy Smarty theme because style.css
  already contains the pixel-near desktop/mobile rules for these classes.
#}
{% set skNavigationTitle = oView.getTitle()|striptags|trim %}
<aside class="side-menu-complete sk-side-menu" aria-label="Shopnavigation">
    <div class="shop-menu">
        {{ include_widget({
            cl: "oxwCategoryTree",
            cnid: oView.getCategoryId(),
            deepLevel: 0,
            noscript: 1,
            nocookie: 1
        }) }}
    </div>

    {# The legacy storefront uses the same curated manufacturer navigation on
       every shop, CMS, account and detail page. View-specific manufacturer
       collections are not reliable on OXID detail/account controllers, hence
       the stable SEO links below. #}
    <div class="shop-menu sk-brand-menu">
        <ul class="all-brands">
            <li>Nach Marken</li>
            <li><a href="/Nach-Hersteller/Faerg-Form/"{% if skNavigationTitle in ['Färg & Form', 'Faerg & Form'] %} class="act" aria-current="page"{% endif %}>F&auml;rg &amp; Form</a></li>
            <li><a href="/Nach-Hersteller/Holmegaard/"{% if skNavigationTitle == 'Holmegaard' %} class="act" aria-current="page"{% endif %}>Holmegaard</a></li>
            <li><a href="/Nach-Hersteller/Kay-Bojesen/"{% if skNavigationTitle == 'Kay Bojesen' %} class="act" aria-current="page"{% endif %}>Kay Bojesen</a></li>
            <li><a href="/Nach-Hersteller/Kortkartellet/"{% if skNavigationTitle == 'Kortkartellet' %} class="act" aria-current="page"{% endif %}>Kortkartellet</a></li>
            <li><a href="/Nach-Hersteller/Livingly/"{% if skNavigationTitle == 'Livingly' %} class="act" aria-current="page"{% endif %}>Livingly</a></li>
            <li><a href="/Nach-Hersteller/Marimekko/"{% if skNavigationTitle == 'Marimekko' %} class="act" aria-current="page"{% endif %}>Marimekko</a></li>
            <li><a href="/Nach-Hersteller/Pia-Malmros/"{% if skNavigationTitle == 'Pia Malmros' %} class="act" aria-current="page"{% endif %}>Pia Malmros</a></li>
            <li><a href="/Nach-Hersteller/Pluto-Produkter/"{% if skNavigationTitle == 'Pluto Produkter' %} class="act" aria-current="page"{% endif %}>Pluto Produkter</a></li>
            <li><a href="/Nach-Hersteller/Roros-Tweed/"{% if skNavigationTitle in ['Røros-Tweed', 'Roros-Tweed'] %} class="act" aria-current="page"{% endif %}>R&oslash;ros-Tweed</a></li>
        </ul>
    </div>

    <div class="shop-info-menu">
        <ul class="shop-info">
            <li><a href="/Versand-Kosten/">Versand und Kosten</a></li>
            <li><a href="/Widerrufsrecht/">Widerrufsrecht</a></li>
            <li><a href="/Impressum/">Impressum</a></li>
            <li><a href="/Datenschutz/">Datenschutz</a></li>
            <li class="open-contact"><a href="#sk-contact">Kontakt</a></li>
        </ul>
    </div>
</aside>
