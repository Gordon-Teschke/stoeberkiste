    {% else %}
        <a href="{{ seo_url({ ident: oViewConf.getSelfLink() ~ 'cl=register' }) }}">Registrieren</a>
        <a href="{{ seo_url({ ident: oViewConf.getSelfLink() ~ 'cl=account' }) }}">Anmelden</a>
    {% endif %}
    <a href="{{ seo_url({ ident: oViewConf.getSelfLink() ~ 'cl=account_noticelist' }) }}">Merkliste</a>
</nav>
