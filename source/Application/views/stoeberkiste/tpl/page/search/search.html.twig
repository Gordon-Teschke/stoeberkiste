{% set searchTitle = "SEARCH"|translate %}
{% set searchParam = oView.getSearchParamForHtml() %}
{% set templateTitle = searchTitle ~ " - " ~ searchParam %}
{% set searchHead = oView.getArticleCount() ~ " " ~ ("HITS_FOR"|translate) ~ ' "' ~ searchParam ~ '"' %}

{% capture append = "oxidBlock_content" %}
    <div class="bg-white sk-list-header">
        <img src="/out/stoeberkiste/img/header-shop.jpg"
             alt="{{ searchTitle }}"
             class="sk-header-image">
    </div>

    <div class="article-list sk-legacy-list-page sk-search-results-page">
        <div class="container-xxl sk-list-body">
            {% include "widget/sidebar/shop_navigation.html.twig" with {show_counts: true} %}

            <section class="sk-product-list-panel all-items">
                <div class="sk-list-intro">
                    <h1>Suchergebnisse: {{ searchHead }}</h1>
                </div>

                {% if oView.getArticleList() %}
                    {% block search_list_productlist %}
                        {% include "widget/product/list.html.twig" with {
                            type: "line",
                            listId: "searchList",
                            products: oView.getArticleList(),
                            showMainLink: true
                        } %}
                    {% endblock %}

                    {% block search_bottom_listlocator %}
                        {% include "widget/locator/listlocator.html.twig" with {
                            locator: oView.getPageNavigationLimitedBottom(),
                            place: "bottom"
                        } %}
                    {% endblock %}
                {% else %}
                    <p class="alert alert-info">{{ translate({ ident: "NO_ITEMS_FOUND" }) }}</p>
                {% endif %}
            </section>
        </div>
    </div>

    {{ insert_tracker({title: templateTitle}) }}
{% endcapture %}

{% include "layout/page.html.twig" with {title: templateTitle} %}
