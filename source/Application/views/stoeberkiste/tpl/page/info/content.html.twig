{% capture append = "oxidBlock_content" %}
    {% set oContent = oView.getContent() %}
    {% set template_title = oView.getTitle() %}

    <div class="bg-white sk-content-header sk-list-header">
        <img src="/out/stoeberkiste/img/header-shop.jpg" alt="" class="sk-header-image">
    </div>

    <div class="container-xxl sk-content-body sk-legacy-content-layout">
        {% include "widget/sidebar/shop_navigation.html.twig" %}

        <section class="sk-content-main all-items page">
            {% if not oContent.oxcontents__ddhidetitle.value %}
                <h1 id="test_contentHeader" class="boxhead">{{ template_title }}</h1>
            {% endif %}
            <div class="clearfix"></div>
            <article id="test_contentBody" class="cmsContent box">
                {{ oView.getParsedContent() | sanitize_html }}
            </article>
        </section>
    </div>

    {{ insert_tracker({title: template_title}) }}
{% endcapture %}
{% include "layout/page.html.twig" %}
