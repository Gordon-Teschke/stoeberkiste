<div id="detailsMain" class="details">
    {% include "page/details/inc/productmain.html.twig" %}

    {% set oDetailsProduct = oView.getProduct() %}
    <form id="contact-ajax-detail" method="post" action="{{ oViewConf.getSslSelfLink()|raw }}" class="product-mail sk-product-question needs-validation">
        {{ oViewConf.getHiddenSid()|raw }}
        <input type="hidden" name="fnc" value="send">
        <input type="hidden" name="cl" value="contact">
        <input type="hidden" name="editval[oxuser__oxlname]" value="-">
        <input type="hidden" name="c_subject" value="Produktanfrage: {{ oDetailsProduct.oxarticles__oxtitle.value }} {{ oDetailsProduct.oxarticles__oxvarselect.value }} | Art.-Nr. {{ oDetailsProduct.oxarticles__oxartnum.value }}">
        <p>Haben Sie Fragen zu diesem Artikel? Schreiben Sie uns:</p>
        <input type="hidden" name="ArtikelName" value="{{ oDetailsProduct.oxarticles__oxtitle.value }} {{ oDetailsProduct.oxarticles__oxvarselect.value }}">
        <input type="hidden" name="ArtikelNr" value="{{ oDetailsProduct.oxarticles__oxartnum.value }}">
        <input type="text" name="editval[oxuser__oxfname]" value="" placeholder="Ihr Name" class="small-input" required>
        <input type="email" name="editval[oxuser__oxusername]" value="" placeholder="Ihre E-Mail Adresse" class="small-input right-input" required>
        <textarea name="c_message" placeholder="Ihre Nachricht an uns..." required></textarea>
        <input type="checkbox" name="c_oegdproptin" value="1" id="dsgvo-product" class="sk-dsgvo-check" required>
        <label for="dsgvo-product" class="sk-dsgvo-label">Ich habe die <a href="/Datenschutz/">Datenschutzerkl&auml;rung</a> gelesen und erkl&auml;re mich mit der Speicherung und Verarbeitung meiner Daten durch diese Website zum Zweck der Kontaktaufnahme durch den Webseitenbetreiber einverstanden.</label>
        <div class="sk-product-question-response" role="status" aria-live="polite"></div>
        <input type="submit" value="Nachricht senden" class="btn" id="submit-product-detail">
    </form>

    <!-- CMS -->

    {# The reference theme does not render the Apex review panel on product
       detail pages. Reviews remain in the data model, but the visual panel is
       intentionally omitted for parity with the live storefront. #}
    {% block details_productmain_reviews %}{% endblock %}

    {% include_content 'oxstartslot4' ignore missing %}
</div>

<div class="details-more row-spacer">
    <div class="container-xxl">
        <div class="row">
            {% set oManufacturer = oView.getManufacturer() %}
            {% if oManufacturer and oManufacturer.oxmanufacturers__oxshortdesc.value %}
                <div class="col-12 col-md-6">
                    <div class="details-more-manufacturer">
                        {% if oManufacturer and oManufacturer.getIconUrl() %}
                            {% set aImgDimensions = oManufacturer.getIconUrl()|getimagesize %}
                            <img loading="lazy" class="manufacturer-list-logo" src="{{ oManufacturer.getIconUrl()|raw }}"
                                 alt="{{ translate({ ident: "MANUFACTURER_IMAGE_ALT", args: oManufacturer.oxmanufacturers__oxtitle.value }) }}" width="{{ aImgDimensions.0 }}"
                                 height="{{ aImgDimensions.1 }}">
                        {% else %}
                            <div class="h5">{{ oManufacturer.oxmanufacturers__oxtitle.value }}</div>
                        {% endif %}
                        <p>{{ oManufacturer.oxmanufacturers__oxshortdesc.value }}</p>
                        <a class="btn btn-outline-primary" href="{{ oManufacturer.getLink()|raw }}"
                           title="{{ oManufacturer.oxmanufacturers__oxtitle.value }}">
                            {{ translate({ ident: "SHOW_ME_MORE" }) }}
                        </a>
                    </div>
                </div>
            {% endif %}

            <div class="col-12 col-md-6">
                <div class="details-more-cms">
                    <!-- CMS Content goes here -->
                </div>
            </div>
        </div>
    </div>
</div>

<div id="detailsRelated" class="details-related">
    {% include "page/details/inc/related_products.html.twig" %}
</div>
