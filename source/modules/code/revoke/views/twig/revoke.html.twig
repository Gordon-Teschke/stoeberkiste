{% capture append = "oxidBlock_head" %}
    <link rel="stylesheet" href="{{ oViewConf.getBaseDir()|raw }}out/modules/coderevoke/out/src/css/revoke.css?v=20260925-account-laden-2">
{% endcapture %}

{% capture append = "oxidBlock_content" %}
    <div class="bg-white sk-content-header sk-list-header">
        <img src="/out/stoeberkiste/img/header-shop.jpg" alt="" class="sk-header-image">
    </div>

    <div class="container-xxl sk-content-body sk-legacy-content-layout sk-revoke-layout">
        {% include "widget/sidebar/shop_navigation.html.twig" %}

        <section class="sk-content-main all-items page sk-cms-typography">
            <h1 id="test_contentHeader" class="boxhead">{{ translate({ ident: "REVOKE_HEADER" }) }}</h1>
            <div class="clearfix"></div>

            <article id="test_contentBody" class="cmsContent box sk-revoke-page">
            {% if sent %}
                <div class="sk-revoke-success">{{ translate({ ident: "REVOKE_SUCCESS" }) }}</div>
            {% else %}

            {% if not preview %}
                <form class="sk-revoke-form" id="revokeForm" action="{{ seo_url({ ident: oViewConf.getSelfLink() }) }}" method="post">
                    <input type="hidden" name="cl" value="revoke">

                    <div class="form-group">
                        <label class="visually-hidden" for="revoke_article">{{ translate({ ident: "REVOKE_ARTICLE_LABEL" }) }}</label>
                        <textarea class="form-control requiredField" name="article" id="revoke_article" rows="2" placeholder="Hiermit widerrufe ich den Kauf folgender Waren... *" required>{{ formdata.article }}</textarea>
                    </div>

                    <div class="form-group">
                        <label class="visually-hidden" for="revoke_ordered">{{ translate({ ident: "REVOKE_ORDERED_LABEL" }) }}</label>
                        <input class="form-control requiredField" type="text" name="ordered" id="revoke_ordered" value="{{ formdata.ordered }}" placeholder="Bestellt am / Erhalten am *" required>
                    </div>

                    <div class="form-group">
                        <label class="visually-hidden" for="revoke_ordernr">{{ translate({ ident: "REVOKE_ORDERNR_LABEL" }) }}</label>
                        <input class="form-control requiredField" type="text" name="ordernr" id="revoke_ordernr" value="{{ formdata.ordernr }}" placeholder="Bestellnummer / Rechnungsnummer *" required>
                    </div>

                    <div class="form-group">
                        <label class="visually-hidden" for="revoke_name">{{ translate({ ident: "REVOKE_NAME_LABEL" }) }}</label>
                        <input class="form-control requiredField" type="text" name="name" id="revoke_name" value="{{ formdata.name }}" placeholder="Name *" required>
                    </div>

                    <div class="form-group">
                        <label class="visually-hidden" for="revoke_email">{{ translate({ ident: "REVOKE_EMAIL_LABEL" }) }}</label>
                        <input class="form-control requiredField emailField" type="email" name="email" id="revoke_email" value="{{ formdata.email }}" placeholder="E-Mail Adresse *" required>
                    </div>

                    <div class="form-group">
                        <label class="visually-hidden" for="revoke_address">{{ translate({ ident: "REVOKE_ADDRESS_LABEL" }) }}</label>
                        <textarea class="form-control" name="address" id="revoke_address" rows="2" placeholder="Adresse">{{ formdata.address }}</textarea>
                    </div>

                    <div class="form-group">
                        <label class="visually-hidden" for="revoke_message">{{ translate({ ident: "REVOKE_MESSAGE_LABEL" }) }}</label>
                        <textarea class="form-control" name="message" id="revoke_message" rows="2" placeholder="Ihre Nachricht an uns...">{{ formdata.message }}</textarea>
                    </div>

                    <p class="sk-revoke-required-info">
                        * Pflichtfelder. Bitte füllen Sie alle mit Stern gekennzeichneten Felder aus.<br>
                        Die E-Mail-Adresse muss gültig sein.
                    </p>

                    <div class="sk-revoke-button-row">
                        <button type="submit" class="revokeButton revokeButtonDisabled" id="revokeSubmitButton" name="fnc" value="preview" disabled>{{ translate({ ident: "REVOKE_SUBMIT_BUTTON" }) }}</button>
                    </div>
                </form>

                <script>
                (function () {
                    var form = document.getElementById('revokeForm');
                    var button = document.getElementById('revokeSubmitButton');
                    if (!form || !button) return;

                    var requiredFields = [
                        document.getElementById('revoke_article'),
                        document.getElementById('revoke_ordered'),
                        document.getElementById('revoke_ordernr'),
                        document.getElementById('revoke_name'),
                        document.getElementById('revoke_email')
                    ];

                    function validateForm() {
                        var valid = true;
                        requiredFields.forEach(function (field) {
                            var value = field.value.trim();
                            var fieldValid = value.length > 0;
                            if (field.id === 'revoke_email') {
                                fieldValid = fieldValid && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
                            }
                            field.classList.toggle('revokeError', value.length > 0 && !fieldValid);
                            valid = valid && fieldValid;
                        });
                        button.disabled = !valid;
                        button.classList.toggle('revokeButtonDisabled', !valid);
                    }

                    requiredFields.forEach(function (field) {
                        field.addEventListener('input', validateForm);
                        field.addEventListener('change', validateForm);
                        field.addEventListener('blur', validateForm);
                    });
                    validateForm();
                }());
                </script>
            {% else %}
                <h2>{{ translate({ ident: "REVOKE_CONFIRM_TEXT" }) }}</h2>
                <div id="revoke_wrap" class="sk-revoke-preview">
                    <table class="table table-striped">
                        <tr><th>{{ translate({ ident: "REVOKE_ARTICLE_LABEL" }) }}</th><td>{{ formdata.article|nl2br }}</td></tr>
                        <tr><th>{{ translate({ ident: "REVOKE_ORDERED_LABEL" }) }}</th><td>{{ formdata.ordered|nl2br }}</td></tr>
                        <tr><th>{{ translate({ ident: "REVOKE_ORDERNR_LABEL" }) }}</th><td>{{ formdata.ordernr|nl2br }}</td></tr>
                        <tr><th>{{ translate({ ident: "REVOKE_NAME_LABEL" }) }}</th><td>{{ formdata.name|nl2br }}</td></tr>
                        <tr><th>{{ translate({ ident: "REVOKE_EMAIL_LABEL" }) }}</th><td>{{ formdata.email|nl2br }}</td></tr>
                        <tr><th>{{ translate({ ident: "REVOKE_ADDRESS_LABEL" }) }}</th><td>{{ formdata.address|nl2br }}</td></tr>
                        <tr><th>{{ translate({ ident: "REVOKE_MESSAGE_LABEL" }) }}</th><td>{{ formdata.message|nl2br }}</td></tr>
                    </table>

                    <form class="sk-revoke-actions" action="{{ seo_url({ ident: oViewConf.getSelfLink() }) }}" method="post">
                        <input type="hidden" name="cl" value="revoke">
                        <input type="hidden" name="article" value="{{ formdata.article }}">
                        <input type="hidden" name="ordered" value="{{ formdata.ordered }}">
                        <input type="hidden" name="ordernr" value="{{ formdata.ordernr }}">
                        <input type="hidden" name="name" value="{{ formdata.name }}">
                        <input type="hidden" name="email" value="{{ formdata.email }}">
                        <input type="hidden" name="address" value="{{ formdata.address }}">
                        <input type="hidden" name="message" value="{{ formdata.message }}">

                        <div class="form-group sk-revoke-button-row">
                            <button type="submit" onclick="document.getElementById('revoke_overlay').style.display='block'" class="btn btn-primary" name="fnc" value="submit">{{ translate({ ident: "REVOKE_CONFIRM_BUTTON" }) }}</button>
                        </div>
                        <div class="form-group sk-revoke-button-row">
                            <button type="submit" class="btn btn-secondary" name="fnc" value="repeat">{{ translate({ ident: "REVOKE_CORRECT_BUTTON" }) }}</button>
                        </div>
                    </form>

                    <div id="revoke_overlay"><div class="loader"></div></div>
                </div>
            {% endif %}
            {% endif %}
            </article>
        </section>
    </div>
{% endcapture %}

{% set template_title = "REVOKE_HEADER"|translate %}
{% include "layout/page.html.twig" with {title: template_title, location: template_title} %}
